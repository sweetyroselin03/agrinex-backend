# ------------------------------------------------------------------------------
# AgriNex Backend Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# ------------------------------------------------------------------------------

# Environment Setting (production or development)
ENV=production
# Set to true to show FastAPI /docs and /redoc pages in production
SHOW_DOCS=false

# Allowed CORS Origins (comma-separated list, e.g. https://agrinex.onrender.com,http://localhost:8081)
# If left empty, defaults to wildcard '*' (and credentials support will be disabled in CORSMiddleware)
ALLOWED_ORIGINS=

# Database Configuration (Neon PostgreSQL for production, Sqlite fallback used if empty)
# Example: postgresql://username:password@ep-host-pooler.region.neon.tech/dbname?sslmode=require
DATABASE_URL=your_neon_postgresql_url_here

# JWT Configuration
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Groq AI Configuration (Required for Crop Diagnosis & Chat)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Email Configuration (Brevo Transactional REST API)
# IMPORTANT: No spaces around = signs!
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM=your_from_email@example.com

# Twilio Verification SMS Configuration (Optional - Twilio Verify service for OTP via SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
